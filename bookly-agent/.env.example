# Copy this file to `.env` and fill in values as each phase needs them.
# Phase 1 needs NONE of these - the deterministic core runs with no secrets.

# --- Phase 2: the model -------------------------------------------------------
# Your Anthropic API key (https://console.anthropic.com/). Needed to call Claude.
ANTHROPIC_API_KEY=

# --- Phase 5: real data (Supabase) -------------------------------------------
# Which data store the agent uses: mock (in-memory seed) or supabase.
# Default is mock (offline seed data) — set to supabase to use a real database.
BOOKLY_DATA=mock
# From your Supabase project settings -> API.
SUPABASE_URL=
# Server-side secret: the agent reads orders and writes returns, which RLS
# blocks for the anon key. Never ship this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# The storefront's browser key - not used by the agent.
SUPABASE_ANON_KEY=

# --- Phase 6: HTTP API -------------------------------------------------------
# Browser origins allowed to call /chat (comma-separated). Add the Vercel URL.
ALLOWED_ORIGINS=http://localhost:3000
# Optional: also allow origins matching a regex (e.g. Vercel preview URLs).
# ALLOWED_ORIGIN_REGEX=https://bookly-.*\.vercel\.app
